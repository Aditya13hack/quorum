{
  "name": "@quorum/engine",
  "version": "1.0.0",
  "private": true,
  "description": "Core business-logic engine for the Quorum platform — pure functions, no runtime dependencies",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./src/*.js": "./src/*.ts",
    "./src/*": "./src/*",
    "./*.js": "./src/*.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@quorum/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
