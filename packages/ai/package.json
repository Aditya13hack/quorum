{
  "name": "@quorum/ai",
  "version": "1.0.0",
  "private": true,
  "description": "AI agent roles, prompt schemas, and provider wrappers for Quorum",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./src/*.js": "./src/*.ts",
    "./src/*": "./src/*",
    "./*.js": "./src/*.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@quorum/shared": "workspace:*",
    "@quorum/guard": "workspace:*",
    "@quorum/engine": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
