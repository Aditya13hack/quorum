# ============================================
# Quorum - Environment Variables
# ============================================
# Copy this file to .env and fill in the values
# NEVER commit .env to the repository
# ============================================

# --- PayPal (SANDBOX ONLY - app refuses to start otherwise) ---
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PLATFORM_MERCHANT_ID=
PAYPAL_PARTNER_ATTRIBUTION_ID=

# --- AI Provider ---
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash
AI_API_KEY=
AI_MODE=scripted
MAX_AI_CALLS_PER_DAY=1000

# --- Channel3 ---
CHANNEL3_API_KEY=

# --- Admin & Demo ---
ADMIN_TOKEN=quorum-admin-dev-token
SELLER_DEMO_TOKEN=quorum-seller-dev-token
PUBLIC_BASE_URL=http://localhost:5173
DEMO_MODE=true
TIME_SCALE=1440

# --- Rate Limits ---
RATE_LIMIT_JOINS_PER_ACCOUNT=5
RATE_LIMIT_JOINS_PER_IP=20
RATE_LIMIT_AI_PER_COALITION=50
